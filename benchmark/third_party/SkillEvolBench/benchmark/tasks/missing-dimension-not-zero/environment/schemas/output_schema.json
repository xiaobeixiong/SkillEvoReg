{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E5-LS2-T3 output contract",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "provenance": {
      "type": "object",
      "required": [
        "source_ids",
        "method"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "family": {
      "const": "evidence-grounded-comparison"
    }
  }
}
