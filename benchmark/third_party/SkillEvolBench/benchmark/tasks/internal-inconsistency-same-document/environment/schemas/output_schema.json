{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "consistency audit output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "checked_pairs",
    "contradictions",
    "results"
  ],
  "properties": {
    "checked_pairs": {
      "type": "integer"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "pair_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "pair_id",
          "type",
          "reason",
          "evidence"
        ]
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "pair_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "pair_id",
          "label",
          "type",
          "reason"
        ]
      }
    }
  }
}
