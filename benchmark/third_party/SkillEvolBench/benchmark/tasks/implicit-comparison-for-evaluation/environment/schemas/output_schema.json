{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evaluation output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dimensions",
    "recommendation"
  ],
  "properties": {
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comparison": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "recommendation": {}
  }
}
