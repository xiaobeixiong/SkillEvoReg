{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim review output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "reviews"
  ],
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "correction"
        ]
      }
    }
  }
}
