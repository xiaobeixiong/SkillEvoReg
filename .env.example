# Export these in your shell. No actual key is included.
export OPENAI_API_KEY="YOUR_API_KEY"
export OPENAI_BASE_URL="https://your-compatible-provider.example/v1"
# For local BGE retrieval, point at a snapshot containing tokenizer.json and onnx/model.onnx.
export SKILLEVOREG_EMBEDDING_MODEL_PATH="/path/to/bge-base-en-v1.5"
# Optional explicit Codex executable; otherwise resolved from PATH.
# export CODEX_EXEC_PATH="/path/to/codex"
